<?xml version="1.0" encoding="utf-8"?>
<!-- Static widget-picker preview (Android 12-14; 15+ uses Glance generated previews). RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="My ticket · Sydney"
        android:textColor="@color/widget_preview_on_background_variant"
        android:textSize="12sp" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Campfire Sydney"
        android:textColor="@color/widget_preview_on_background"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="in 3 days"
        android:textColor="@color/widget_preview_on_container"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_preview_tile"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp" />
</LinearLayout>
