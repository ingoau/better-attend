<?xml version="1.0" encoding="utf-8"?>
<!-- Static widget-picker preview (Android 12-14; 15+ uses Glance generated previews). RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Campfire Sydney"
        android:textColor="@color/widget_preview_on_background_variant"
        android:textSize="13sp" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="84"
            android:textColor="@color/widget_preview_accent"
            android:textSize="44sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=" / 120"
            android:textColor="@color/widget_preview_on_background_variant"
            android:textSize="18sp" />
    </LinearLayout>
    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="100"
        android:progress="70"
        android:progressBackgroundTint="@color/widget_preview_track"
        android:progressTint="@color/widget_preview_accent" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="36 not here yet"
        android:textColor="@color/widget_preview_on_background"
        android:textSize="12sp"
        android:layout_marginTop="6dp" />
</LinearLayout>
